# Copy to .env.local and fill in.
# Supabase: Project Settings > API. Both values are public by design.
# Never put the service-role key or the VAPID private key in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public half of the Web Push key pair. The private half lives in Supabase
# secrets (VAPID_PRIVATE_KEY) for the push-dispatch function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
